# Root .env — read by Docker Compose only.
#
# Compose substitutes these into docker-compose.yml before any container
# starts. It is NOT the same file as backend/.env, which is loaded by the
# Node process when you run the backend directly on your host.
#
#   cp .env.example .env    then fill in the values below.
#
# Every variable here is required: docker-compose.yml references all of them
# as ${...}. A missing value becomes an empty string and MySQL refuses to
# initialise.

# Database — configures the MySQL container itself and the backend's
# connection to it. Any values work locally; the database is created on
# first boot. Host port is 3307 (see docker-compose.yml) to avoid clashing
# with a local MySQL on 3306.
DB_PASSWORD=your_mysql_root_password
DB_NAME=doctor_appointment

# Security — generate a long random string (e.g. `openssl rand -hex 64`)
JWT_SECRET=your_long_random_secret_here

# Cloudinary — doctor photos and profile picture uploads
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_secret

# Email (Resend) — verification and password-reset messages
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=onboarding@resend.dev
