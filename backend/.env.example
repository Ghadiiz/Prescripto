# Server
PORT=3000
NODE_ENV=development

# Security — generate a long random string (e.g. `openssl rand -hex 64`)
JWT_SECRET=your_long_random_secret_here

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=doctor_appointment

# Cloudinary — required only for image uploads (doctor photos, profile pictures)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_secret

# Email (Resend) — optional. If RESEND_API_KEY is unset the app still runs;
# emails are skipped and a warning is logged instead.
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# App URLs — used to build links inside emails
FRONTEND_URL=http://localhost:5173
ADMIN_PANEL_URL=http://localhost:5174

# CORS — comma-separated list of allowed browser origins.
# Defaults to the two localhost ports if unset.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Gemini (AI assistant) — required once the assistant endpoints exist.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional. Where model rotation STARTS (it no longer pins). The free-tier
# quota is 20 requests per day PER MODEL, so the assistant falls through to the
# other models when one is spent. Note that ListModels advertises older ids
# (e.g. gemini-2.5-flash) that generateContent rejects for newer accounts, so
# verify a model actually answers before naming it here.
GEMINI_MODEL=gemini-3.6-flash
# Optional. Replaces the rotation list outright, comma-separated. A single id
# pins that one model, which is how the eval targets a specific model.
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
# Optional. Defaults to 50. A self-imposed daily ceiling on ACTUAL Gemini calls
# (one chat turn is several), kept under the ~60 the three models allow, so the
# app stops itself with a friendly message before Google starts refusing.
# GEMINI_DAILY_CALL_CAP=50
